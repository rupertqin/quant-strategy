---
import MainLayout from '@layouts/MainLayout.astro';
import { loadTechnicalData, loadPoolWatchData, loadLongTermWeights } from '@utils/dataLoader';

const techData = await loadTechnicalData();
const poolData = await loadPoolWatchData();
const weights = await loadLongTermWeights();

const regime = techData?.market_type || 'NEUTRAL';
const regimeColor = { AGGRESSIVE: 'text-green-600', DEFENSIVE: 'text-red-600', NEUTRAL: 'text-yellow-600' };
const regimeName = { AGGRESSIVE: '积极', DEFENSIVE: '防御', NEUTRAL: '中性' };

const hotSectors = techData?.hot_sectors?.slice(0, 5) || [];
const topWeight = weights?.[0];
---

<MainLayout title="首页" description="量化交易看板 - 长线战略配置 + 短线战术扫描">
  <!-- Hero 区域 -->
  <div class="text-center mb-16 pt-8">
    <h1 class="text-4xl md:text-5xl leading-tight font-bold mb-6 tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-600 pb-2">
      智能股票趋势分析系统
    </h1>
    <p class="text-slate-500 text-lg md:text-xl max-w-3xl mx-auto font-light">
      基于人工智能和大数据技术，为投资者提供专业、精准的股票趋势分析和智能选股服务。
    </p>
  </div>

  <!-- 顶部状态栏 -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
    <div class="metric-card text-center">
      <p class="text-[13px] font-medium tracking-wide uppercase text-slate-500 mb-2">市场状态</p>
      <p class:list={['text-3xl font-bold tracking-tight', regimeColor[regime] || 'text-slate-800']}>
        {regimeName[regime] || '未知'}
      </p>
    </div>
    <div class="metric-card text-center">
      <p class="text-[13px] font-medium tracking-wide uppercase text-slate-500 mb-2">风险评分</p>
      <p class="text-3xl font-bold tracking-tight text-slate-800">
        {(techData?.composite_score || 50) / 10}<span class="text-xl text-slate-400">/10</span>
      </p>
    </div>
    <div class="metric-card text-center">
      <p class="text-[13px] font-medium tracking-wide uppercase text-slate-500 mb-2">涨停家数</p>
      <p class="text-3xl font-bold tracking-tight text-fin-up">{techData?.total_zt_count || 0}</p>
    </div>
    <div class="metric-card text-center">
      <p class="text-[13px] font-medium tracking-wide uppercase text-slate-500 mb-2">股票池买入信号</p>
      <p class="text-3xl font-bold tracking-tight text-blue-600">{poolData?.summary?.buy_count || 0}</p>
    </div>
  </div>

  <!-- 功能模块导航 -->
  <h2 class="text-2xl font-bold mb-6 text-slate-800 tracking-tight">核心功能</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <a href="/today-technical/" class="metric-card group flex flex-col justify-between min-h-[160px]">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center text-xl shadow-sm border border-orange-100/50">
            🔥
          </div>
          <h3 class="text-lg font-bold text-slate-800 group-hover:text-blue-600 transition-colors">今日技术面</h3>
        </div>
        <p class="text-[15px] text-slate-500 leading-relaxed">全市场涨停板扫描、板块热度分析、指数走势</p>
      </div>
      <div class="mt-4 text-blue-600 text-sm font-semibold flex items-center gap-1">进入分析 <span class="group-hover:translate-x-1 transition-transform">→</span></div>
    </a>
    <a href="/pool-watch/" class="metric-card group flex flex-col justify-between min-h-[160px]">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center text-xl shadow-sm border border-blue-100/50">
            📊
          </div>
          <h3 class="text-lg font-bold text-slate-800 group-hover:text-blue-600 transition-colors">股票池监控</h3>
        </div>
        <p class="text-[15px] text-slate-500 leading-relaxed">LongTerm股票池短线技术指标、均线系统分析</p>
      </div>
      <div class="mt-4 text-blue-600 text-sm font-semibold flex items-center gap-1">进入监控 <span class="group-hover:translate-x-1 transition-transform">→</span></div>
    </a>
    <a href="/signal-watch/" class="metric-card group flex flex-col justify-between min-h-[160px]">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center text-xl shadow-sm border border-indigo-100/50">
            📡
          </div>
          <h3 class="text-lg font-bold text-slate-800 group-hover:text-blue-600 transition-colors">信号预警</h3>
        </div>
        <p class="text-[15px] text-slate-500 leading-relaxed">左侧/右侧交易信号、风险雷达、健康度评分</p>
      </div>
      <div class="mt-4 text-blue-600 text-sm font-semibold flex items-center gap-1">查看详情 <span class="group-hover:translate-x-1 transition-transform">→</span></div>
    </a>
  </div>

  <!-- 两栏布局 -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- 左侧：今日技术面摘要 -->
    <div class="metric-card">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-slate-800 tracking-tight">🔥 技术面摘要</h3>
        <a href="/today-technical/" class="text-sm text-blue-600 hover:text-blue-700 font-medium">查看详情 &rarr;</a>
      </div>
      {techData ? (
        <div class="space-y-6">
          <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-100">
            <span class="text-slate-600 font-medium">涨停家数</span>
            <span class="text-3xl font-bold text-fin-up">{techData.total_zt_count}</span>
          </div>
          {hotSectors.length > 0 && (
            <div>
              <p class="text-sm font-medium tracking-wide uppercase text-slate-500 mb-3">热点板块</p>
              <div class="flex flex-wrap gap-2">
                {hotSectors.map(sector => (
                  <span class="px-3 py-1.5 bg-blue-50 text-blue-700 font-medium text-sm rounded-lg border border-blue-100/50">
                    {sector.sector} <span class="text-blue-400 opacity-80 ml-1">({sector.zt_count})</span>
                  </span>
                ))}
              </div>
            </div>
          )}
          <div class="text-[13px] text-slate-400 mt-4 flex items-center justify-between">
            <span>数据时间: {techData.date ? String(techData.date).replace(/(\d{4})(\d{2})(\d{2})/, '$1-$2-$3') : techData._generated_at || '--'}</span>
          </div>
        </div>
      ) : (
        <p class="text-slate-500 py-8 text-center bg-slate-50 rounded-xl border border-slate-100 border-dashed">暂无数据，请先运行扫描脚本</p>
      )}
    </div>

    <!-- 右侧：股票池监控摘要 -->
    <div class="metric-card">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-slate-800 tracking-tight">📊 股票池摘要</h3>
        <a href="/pool-watch/" class="text-sm text-blue-600 hover:text-blue-700 font-medium">进入监控 &rarr;</a>
      </div>
      {poolData ? (
        <div class="space-y-6">
          <div class="grid grid-cols-3 gap-4">
            <div class="text-center p-4 bg-emerald-50 rounded-xl border border-emerald-100/50">
              <p class="text-3xl font-bold text-emerald-600 mb-1">{poolData.summary?.buy_count || 0}</p>
              <p class="text-sm font-medium text-emerald-700/80">买入</p>
            </div>
            <div class="text-center p-4 bg-red-50 rounded-xl border border-red-100/50">
              <p class="text-3xl font-bold text-red-600 mb-1">{poolData.summary?.sell_count || 0}</p>
              <p class="text-sm font-medium text-red-700/80">卖出</p>
            </div>
            <div class="text-center p-4 bg-amber-50 rounded-xl border border-amber-100/50">
              <p class="text-3xl font-bold text-amber-600 mb-1">{poolData.summary?.watch_count || 0}</p>
              <p class="text-sm font-medium text-amber-700/80">观察</p>
            </div>
          </div>
          <div class="text-[13px] text-slate-400 mt-4 flex items-center justify-between">
            <span>数据时间: {poolData.date}</span>
          </div>
        </div>
      ) : (
        <p class="text-slate-500 py-8 text-center bg-slate-50 rounded-xl border border-slate-100 border-dashed">暂无数据</p>
      )}
    </div>
  </div>

  <!-- 综合交易建议 -->
  <div class="mt-8 metric-card bg-gradient-to-br from-white to-slate-50/50">
    <h3 class="text-xl font-bold mb-6 text-slate-800 tracking-tight flex items-center gap-2">💡 综合交易建议</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="p-5 bg-white rounded-xl shadow-sm border border-slate-100">
        <p class="text-sm font-medium tracking-wide uppercase text-slate-500 mb-4">仓位建议</p>
        <div class="w-full bg-slate-100 rounded-full h-4 overflow-hidden mb-3">
          <div
            class="bg-blue-600 h-full rounded-full transition-all duration-1000 ease-out relative"
            style={`width: ${regime === 'AGGRESSIVE' ? '100%' : regime === 'DEFENSIVE' ? '30%' : '70%'}`}
          >
            <div class="absolute inset-0 bg-white/20 w-full h-full" style="background-image: linear-gradient(45deg, rgba(255,255,255,.15) 25%, transparent 25%, transparent 50%, rgba(255,255,255,.15) 50%, rgba(255,255,255,.15) 75%, transparent 75%, transparent); background-size: 1rem 1rem;"></div>
          </div>
        </div>
        <p class="text-base font-semibold text-slate-700">
          {regime === 'AGGRESSIVE' ? '100% 建议满仓' : regime === 'DEFENSIVE' ? '30% 建议轻仓' : '70% 建议中等仓位'}
        </p>
      </div>
      <div class="p-5 bg-white rounded-xl shadow-sm border border-slate-100">
        <p class="text-sm font-medium tracking-wide uppercase text-slate-500 mb-4">板块偏好</p>
        {hotSectors.length > 0 ? (
          <div class="flex flex-wrap gap-2">
            {hotSectors.map(s => (
              <span class="px-3 py-1.5 bg-slate-50 text-slate-700 font-medium text-sm rounded-lg border border-slate-200 hover:border-blue-300 hover:text-blue-600 cursor-default transition-colors">{s.sector}</span>
            ))}
          </div>
        ) : (
          <p class="text-slate-400">暂无板块推荐</p>
        )}
      </div>
    </div>
  </div>
</MainLayout>
