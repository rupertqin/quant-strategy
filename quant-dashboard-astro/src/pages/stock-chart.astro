---
import MainLayout from '@layouts/MainLayout.astro';
import StockChart from '@components/StockChart.jsx';
import { loadStockNames } from '@utils/dataLoader';

const symbol = Astro.url.searchParams.get('symbol') || '';

// 尝试从文件系统读取历史数据（构建时）
let dailyData = [];
let weeklyData = [];
let monthlyData = [];

// 从 stock_names 加载名称映射
const stockNames = await loadStockNames();
const name = stockNames[symbol] || '';

// 注意：实际历史数据文件较大，这里通过客户端 fetch 加载
// 构建时只做基础准备
---

<MainLayout title={`${symbol} 股票图表`}>
  <div class="mb-4">
    <a href="/signal-watch/" class="text-sm text-blue-600 hover:underline">← 返回信号监控</a>
    <h1 class="text-2xl font-bold mt-2">
      {symbol} {name ? `(${name})` : ''}
    </h1>
  </div>

  <div class="metric-card">
    <StockChart
      client:only="react"
      symbol={symbol}
      dailyData={dailyData}
      weeklyData={weeklyData}
      monthlyData={monthlyData}
    />
  </div>

  <!-- 客户端加载真实数据 -->
  <script define:vars={{ symbol }}>
    // 这里可以通过 fetch 从 /data/prices/${symbol}.json 加载数据
    // 由于数据量可能很大，使用客户端加载
    async function loadChartData() {
      try {
        const res = await fetch(`/data/prices/${symbol}.json`);
        if (res.ok) {
          const data = await res.json();
          // 数据格式转换
          window.__STOCK_DATA__ = data;
        }
      } catch (e) {
        console.error('加载股票数据失败:', e);
      }
    }
    if (symbol) loadChartData();
  </script>
</MainLayout>
