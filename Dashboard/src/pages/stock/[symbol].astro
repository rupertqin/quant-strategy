---
import MainLayout from '@layouts/MainLayout.astro';
import StockChart from '@components/StockChart.jsx';
import StockSignals from '@components/StockSignals.jsx';
import { DEFAULT_POOL } from '@utils/defaultPool.js';
import { readParquetAllRows, readParquetLastRows, toDateString, toNumber } from '@utils/parquet';
import { getStorageDir } from '@utils/env';
import { detectAssetType } from '@utils/assetType';

const path = await import('path');
const fs = await import('fs');

const storageDir = getStorageDir();
const FACTOR_DIR = path.resolve(storageDir, 'raw/stocks/adjust_factor');
const REALTIME_STOCK_DIR = path.resolve(storageDir, 'raw/realtime/stock');

function parseLimitEnv(value: unknown): number | null {
  if (value === undefined || value === null) return null;
  const raw = String(value).trim().toLowerCase();
  if (!raw || raw === 'all' || raw === 'none' || raw === '0') return null;
  const n = Number(raw);
  return Number.isFinite(n) && n > 0 ? Math.floor(n) : null;
}

function formatDateTime(value: unknown): string {
  if (!value) return '';
  const date = new Date(String(value));
  if (!Number.isNaN(date.getTime())) {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    const d = String(date.getDate()).padStart(2, '0');
    const hh = String(date.getHours()).padStart(2, '0');
    const mm = String(date.getMinutes()).padStart(2, '0');
    return `${y}-${m}-${d} ${hh}:${mm}`;
  }

  const raw = String(value).trim();
  if (raw.length >= 16) return raw.slice(0, 16);
  return raw;
}

function toDayString(value: unknown): string {
  if (!value) return '';
  if (value instanceof Date) return value.toISOString().slice(0, 10);

  const raw = String(value).trim();
  const matched = raw.match(/^(\d{4}-\d{2}-\d{2})/);
  if (matched) return matched[1];

  const normalized = raw.replace(' ', 'T');
  const date = new Date(normalized);
  if (!Number.isNaN(date.getTime())) return date.toISOString().slice(0, 10);

  return toDateString(raw);
}

function getScoreLabel(score: number) {
  if (score >= 95) return '极品';
  if (score >= 90) return '优秀';
  if (score >= 80) return '良好';
  if (score >= 65) return '一般';
  return '观察';
}

function getWeekKey(dateStr: string) {
  const date = new Date(dateStr);
  const day = date.getDay();
  const diff = day === 0 ? -2 : day === 6 ? -1 : 5 - day;
  const friday = new Date(date);
  friday.setDate(date.getDate() + diff);
  return friday.toISOString().split('T')[0];
}

function getMonthKey(dateStr: string) {
  const date = new Date(dateStr);
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  return `${y}-${m}`;
}

function adjustToQfq(rows: any[], factors: any[]) {
  const sortedRows = [...rows].sort((a, b) => toDateString(a.trade_date).localeCompare(toDateString(b.trade_date)));
  const sortedFactors = [...factors].sort((a, b) => toDateString(a.trade_date).localeCompare(toDateString(b.trade_date)));

  let factorIdx = 0;
  let currentFactor = 1;

  return sortedRows.map((row: any) => {
    const tradeDate = toDateString(row.trade_date);
    while (factorIdx < sortedFactors.length && toDateString(sortedFactors[factorIdx].trade_date) <= tradeDate) {
      currentFactor = toNumber(sortedFactors[factorIdx].adjust_factor, 1);
      factorIdx += 1;
    }

    return {
      time: tradeDate,
      date: tradeDate,
      trade_date: tradeDate,
      open: +(toNumber(row.open) * currentFactor).toFixed(2),
      high: +(toNumber(row.high) * currentFactor).toFixed(2),
      low: +(toNumber(row.low) * currentFactor).toFixed(2),
      close: +(toNumber(row.close) * currentFactor).toFixed(2),
      volume: toNumber(row.volume),
    };
  });
}

function aggregateToPeriod(rows: any[], period: 'weekly' | 'monthly') {
  const map = new Map<string, any>();

  rows.forEach((d) => {
    const dateStr = toDateString(d.trade_date || d.date || d.time);
    const key = period === 'weekly' ? getWeekKey(dateStr) : getMonthKey(dateStr);
    const candleDate = period === 'monthly' ? dateStr : key;

    if (!map.has(key)) {
      map.set(key, {
        time: candleDate,
        date: candleDate,
        trade_date: candleDate,
        open: d.open,
        high: d.high,
        low: d.low,
        close: d.close,
        volume: d.volume || 0,
      });
    } else {
      const item = map.get(key);
      item.high = Math.max(item.high, d.high);
      item.low = Math.min(item.low, d.low);
      item.close = d.close;
      item.volume += (d.volume || 0);
      if (period === 'monthly') {
        item.time = dateStr;
        item.date = dateStr;
        item.trade_date = dateStr;
      }
    }
  });

  return Array.from(map.values()).sort((a, b) => String(a.trade_date).localeCompare(String(b.trade_date)));
}

async function loadLatestRealtimeRow(symbol: string) {
  if (!fs.existsSync(REALTIME_STOCK_DIR)) return null;

  const realtimeFiles = fs.readdirSync(REALTIME_STOCK_DIR)
    .filter((f) => f.endsWith('.parquet'))
    .sort();

  if (!realtimeFiles.length) return null;

  const latestFile = path.join(REALTIME_STOCK_DIR, realtimeFiles[realtimeFiles.length - 1]);
  const rows = await readParquetAllRows(
    latestFile,
    ['symbol', 'timestamp', 'open', 'high', 'low', 'close', 'volume']
  );

  const matched = rows.filter((r: any) => String(r.symbol) === symbol);
  if (!matched.length) return null;

  return matched.sort((a: any, b: any) => String(a.timestamp || '').localeCompare(String(b.timestamp || '')))[matched.length - 1];
}

function mergeRealtimeIntoDailyRows(rows: any[], realtimeRow: any) {
  if (!realtimeRow) return { rows, merged: false };

  const rtDate = toDayString(realtimeRow.timestamp || realtimeRow.trade_date || realtimeRow.date || realtimeRow.time);
  if (!rtDate) return { rows, merged: false };

  const normalizedRow = {
    trade_date: rtDate,
    open: toNumber(realtimeRow.open, toNumber(realtimeRow.close)),
    high: toNumber(realtimeRow.high, toNumber(realtimeRow.close)),
    low: toNumber(realtimeRow.low, toNumber(realtimeRow.close)),
    close: toNumber(realtimeRow.close),
    volume: toNumber(realtimeRow.volume),
  };

  if (!rows.length) return { rows: [normalizedRow], merged: true };

  const sorted = [...rows].sort((a, b) => toDayString(a.trade_date).localeCompare(toDayString(b.trade_date)));
  const lastDate = toDayString(sorted[sorted.length - 1].trade_date);

  if (rtDate < lastDate) return { rows: sorted, merged: false };
  if (rtDate === lastDate) {
    return { rows: [...sorted.slice(0, -1), normalizedRow], merged: true };
  }
  return { rows: [...sorted, normalizedRow], merged: true };
}

let signalCache: {
  allSignals: Record<string, any>;
  stockNames: Record<string, string>;
  signalMeta: { scanTime: string; priceFetchTime: string };
} | null = null;

function getSignalMaps() {
  if (signalCache) return signalCache;

  let allSignals: Record<string, any> = {};
  let stockNames: Record<string, string> = {};
  let signalMeta = { scanTime: '', priceFetchTime: '' };

  try {
    const namesPath = path.resolve('./src/generated/stock_names.json');
    if (fs.existsSync(namesPath)) {
      const allNames = JSON.parse(fs.readFileSync(namesPath, 'utf-8'));
      if (allNames && typeof allNames === 'object') {
        stockNames = { ...allNames };
      }
    }

    const signalPath = path.resolve('./src/generated/signals.json');
    if (fs.existsSync(signalPath)) {
      const signalData = JSON.parse(fs.readFileSync(signalPath, 'utf-8'));
      signalMeta = {
        scanTime: String(signalData.scan_time || '').trim(),
        priceFetchTime: String(signalData.price_fetch_time || '').trim(),
      };

      const stocksArray = Array.isArray(signalData.stocks) ? signalData.stocks : [];
      const stockMeta = {};
      for (const st of stocksArray) {
        if (st.symbol) {
          stockMeta[st.symbol] = {
            riskScore: st.risk_score || 0,
            riskExplanations: st.risk_explanations || [],
          };
        }
      }

      for (const sig of (signalData.signals || [])) {
        const sym = sig.symbol;
        if (!sym) continue;

        if (!allSignals[sym]) {
          const meta = stockMeta[sym] || {};
          allSignals[sym] = {
            name: sig.name || stockNames[sym] || '',
            signals: [],
            signalScore: 0,
            riskScore: meta.riskScore || 0,
            riskExplanations: meta.riskExplanations || [],
            scoreLabel: '',
            signalCount: 0,
            hasBuySignal: false,
          };
        }

        if (sig.name) {
          stockNames[sym] = sig.name;
          allSignals[sym].name = sig.name;
        }

        allSignals[sym].signals.push(sig);
        allSignals[sym].signalCount += 1;
        allSignals[sym].signalScore = Math.max(allSignals[sym].signalScore || 0, Number(sig.score || 0));
        if (sig.signal_type === 'right') allSignals[sym].hasBuySignal = true;
      }

      for (const sym of Object.keys(allSignals)) {
        allSignals[sym].scoreLabel = getScoreLabel(allSignals[sym].signalScore || 0);
      }
    }
  } catch (e) {
    console.warn('Failed to load signals.json:', (e as Error).message);
  }

  signalCache = { allSignals, stockNames, signalMeta };
  return signalCache;
}

export async function getStaticPaths() {
  // Astro 的 getStaticPaths 运行在隔离作用域：这里显式声明依赖，避免引用外层变量
  const pathMod = await import('path');
  const fsMod = await import('fs');
  const { getStorageDir } = await import('../../utils/env');

  const dirs = [
    pathMod.resolve(getStorageDir(), 'raw/stocks/price'),
    pathMod.resolve(getStorageDir(), 'raw/etf/price'),
    pathMod.resolve(getStorageDir(), 'raw/index/price'),
  ];

  const symbols = new Set<string>();
  for (const dir of dirs) {
    if (!fsMod.existsSync(dir)) continue;
    const files = fsMod.readdirSync(dir).filter(f => f.endsWith('.parquet'));
    for (const f of files) {
      symbols.add(f.replace('.parquet', ''));
    }
  }

  const allSymbols = Array.from(symbols).sort();
  const generateAllStocks = import.meta.env.GENERATE_ALL_STOCKS === '1';
  const poolSymbols = DEFAULT_POOL.filter(s => allSymbols.includes(s));
  const targetSymbols = generateAllStocks ? allSymbols : poolSymbols;

  console.log(`[stock-chart] Routing ${targetSymbols.length} stock pages (mode=${generateAllStocks ? 'all' : 'pool'})...`);

  return targetSymbols.map(symbol => ({ params: { symbol } }));
}

const { symbol } = Astro.params;

const assetType = detectAssetType(symbol);
const PRICE_DIR = path.resolve(storageDir, `raw/${assetType === 'stock' ? 'stocks' : assetType}/price`);

const dailyLimit = parseLimitEnv(import.meta.env.CHART_DAILY_LIMIT);
const weeklyLimit = parseLimitEnv(import.meta.env.CHART_WEEKLY_LIMIT);
const monthlyLimit = parseLimitEnv(import.meta.env.CHART_MONTHLY_LIMIT);

const { allSignals, stockNames, signalMeta } = getSignalMaps();

const defaultSignals = {
  signals: [], signalScore: 0, riskScore: 0,
  riskExplanations: [], scoreLabel: '', signalCount: 0, hasBuySignal: false,
};

const priceColumns = ['trade_date', 'open', 'high', 'low', 'close', 'volume'];
const priceFile = path.join(PRICE_DIR, `${symbol}.parquet`);

let chartData: any[] = [];
let weeklyData: any[] = [];
let monthlyData: any[] = [];
let realtimeRow: any = null;
let isRealtimeMerged = false;

if (fs.existsSync(priceFile)) {
  let allPricesCache: any[] | null = null;
  const getAllPrices = async () => {
    if (!allPricesCache) allPricesCache = await readParquetAllRows(priceFile, priceColumns);
    return allPricesCache;
  };

  realtimeRow = await loadLatestRealtimeRow(symbol);

  const rawDailyRows = dailyLimit
    ? await readParquetLastRows(priceFile, priceColumns, dailyLimit)
    : await getAllPrices();

  const rawWeeklySourceRows = weeklyLimit
    ? await readParquetLastRows(priceFile, priceColumns, weeklyLimit * 5 + 15)
    : await getAllPrices();

  const rawMonthlySourceRows = monthlyLimit
    ? await readParquetLastRows(priceFile, priceColumns, monthlyLimit * 21 + 35)
    : await getAllPrices();

  const dailyMergeResult = mergeRealtimeIntoDailyRows(rawDailyRows, realtimeRow);
  const weeklyMergeResult = mergeRealtimeIntoDailyRows(rawWeeklySourceRows, realtimeRow);
  const monthlyMergeResult = mergeRealtimeIntoDailyRows(rawMonthlySourceRows, realtimeRow);

  isRealtimeMerged = dailyMergeResult.merged;

  const dailyRows = dailyLimit ? dailyMergeResult.rows.slice(-dailyLimit) : dailyMergeResult.rows;
  const weeklySourceRows = weeklyMergeResult.rows;
  const monthlySourceRows = monthlyMergeResult.rows;

  const factorFile = path.join(FACTOR_DIR, `${symbol}.parquet`);
  const factors = fs.existsSync(factorFile)
    ? await readParquetAllRows(factorFile, ['trade_date', 'adjust_factor'])
    : [];

  chartData = adjustToQfq(dailyRows, factors);
  weeklyData = aggregateToPeriod(adjustToQfq(weeklySourceRows, factors), 'weekly');
  monthlyData = aggregateToPeriod(adjustToQfq(monthlySourceRows, factors), 'monthly');
}

const stockName = stockNames[symbol] || '';
const stockSignals = allSignals[symbol] || defaultSignals;

const latest = chartData[chartData.length - 1];
const prev = chartData.length > 1 ? chartData[chartData.length - 2] : latest;
const change = latest ? latest.close - prev.close : 0;
const changePct = prev && prev.close ? (change / prev.close) * 100 : 0;
const isUp = change >= 0;
const priceColor = isUp ? 'text-[#ff4757]' : 'text-[#2ed573]';
const bgColor = isUp ? 'bg-[rgba(255,71,87,0.1)]' : 'bg-[rgba(46,213,115,0.1)]';
const changeSymbol = isUp ? '+' : '';

// 判断是否为盘中实时数据：融合 realtime 且数据时间在 09:30-15:00 之间
let isRealtimeData = false;
let dataTimeText = latest ? latest.date : '--';
if (isRealtimeMerged && realtimeRow?.timestamp) {
  const rt = new Date(String(realtimeRow.timestamp));
  const rtHour = rt.getHours();
  const rtMinute = rt.getMinutes();
  const isMarketTime = (rtHour === 9 && rtMinute >= 30) || (rtHour > 9 && rtHour < 15) || (rtHour === 15 && rtMinute === 0);
  isRealtimeData = isMarketTime;
  dataTimeText = formatDateTime(realtimeRow.timestamp);
}
const dataModeText = isRealtimeData ? '实盘' : '收盘';
---

<MainLayout title={`${symbol} ${stockName} 股票图表`}>
  <div class="mb-6">
    <a href="/signal-watch/" class="text-sm text-primary-600 hover:underline">← 返回信号监控</a>
  </div>

  <!-- 头部信息区 -->
  <div class="mb-6 rounded-xl text-white p-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div>
        <div class="text-2xl font-bold">{stockName || symbol} <span class="text-sm font-normal opacity-80 ml-2">{symbol}</span></div>
        <div class="text-sm opacity-70 mt-1 flex items-center gap-2 flex-wrap">
          <span>数据模式: {dataModeText}</span>
          <span>更新时间: {dataTimeText}</span>
        </div>
      </div>
      <div class="text-right">
        <div class="text-4xl font-bold">{latest ? latest.close.toFixed(2) : '--'}</div>
        <span class={`inline-block text-sm px-3 py-1 rounded-full mt-1 ${bgColor} ${priceColor}`}>
          {changeSymbol}{change.toFixed(2)} ({changeSymbol}{changePct.toFixed(2)}%)
        </span>
      </div>
    </div>
    <div class="grid grid-cols-5 gap-3 mt-4">
      <div class="bg-white/10 rounded-lg p-3 text-center">
        <div class="text-xs opacity-70">今开</div>
        <div class="text-base font-semibold">{latest ? latest.open.toFixed(2) : '--'}</div>
      </div>
      <div class="bg-white/10 rounded-lg p-3 text-center">
        <div class="text-xs opacity-70">最高</div>
        <div class="text-base font-semibold">{latest ? latest.high.toFixed(2) : '--'}</div>
      </div>
      <div class="bg-white/10 rounded-lg p-3 text-center">
        <div class="text-xs opacity-70">最低</div>
        <div class="text-base font-semibold">{latest ? latest.low.toFixed(2) : '--'}</div>
      </div>
      <div class="bg-white/10 rounded-lg p-3 text-center">
        <div class="text-xs opacity-70">昨收</div>
        <div class="text-base font-semibold">{prev ? prev.close.toFixed(2) : '--'}</div>
      </div>
      <div class="bg-white/10 rounded-lg p-3 text-center">
        <div class="text-xs opacity-70">成交量</div>
        <div class="text-base font-semibold">{latest ? (latest.volume / 10000).toFixed(1) : '--'}万</div>
      </div>
    </div>
  </div>

  <!-- 信号折叠区域 -->
  <StockSignals
    client:load
    symbol={symbol}
    signals={stockSignals.signals}
    signalScore={stockSignals.signalScore}
    riskScore={stockSignals.riskScore}
    riskExplanations={stockSignals.riskExplanations}
    scoreLabel={stockSignals.scoreLabel}
    signalCount={stockSignals.signalCount}
    dataMode={dataModeText}
    updateTime={dataTimeText}
  />

  <!-- 图表 -->
  <div class="metric-card">
    <StockChart
      client:only="react"
      symbol={symbol}
      dailyData={chartData}
      weeklyData={weeklyData}
      monthlyData={monthlyData}
      dailyLimit={dailyLimit}
      weeklyLimit={weeklyLimit}
      monthlyLimit={monthlyLimit}
      initialVisibleBars={120}
      zoomOutBars={20}
      chartWidth={500}
      isRealtimeData={isRealtimeData}
      realtimeTime={dataTimeText}
    />
  </div>
</MainLayout>
