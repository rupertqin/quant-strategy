# Quant Strategy 环境变量配置
# 复制此文件为 .env 并修改配置

# Storage 目录路径（默认使用项目目录下的 storage/）
# 可以设置为任意绝对路径，例如：
# QUANT_STORAGE_DIR=/data/quant-storage
# QUANT_STORAGE_DIR=D:\quant-data
# QUANT_STORAGE_DIR=/mnt/nas/quant-storage
QUANT_STORAGE_DIR=

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# 数据爬虫请求间隔（秒）
# 间隔太短可能导致IP被封，太长则同步耗时增加
CRAWLER_REQUEST_DELAY=5

# 数据库配置（未来支持）
# DATABASE_URL=sqlite:///storage/database/quant.db
